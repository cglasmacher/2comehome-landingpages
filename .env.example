APP_NAME="2 COME HOME"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Lokal: log schreibt Mails nach storage/logs/laravel.log
# Produktion: auf smtp setzen und die SMTP-Werte des Mailproviders eintragen
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@2comehome.de
MAIL_FROM_NAME="2 COME HOME Immobilien"
# MAIL_HOST=smtp.example.de
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# --- Landingpages / 2 COME HOME ---
LANDINGPAGE_PUBLIC_DOMAIN=verkauf.2comehome.de
LANDINGPAGE_DEFAULT_RANGE_PERCENT=7.5

# PriceHubble Bewertungs-API (leer lassen = Demo-/Fallback-Modus)
PRICEHUBBLE_BASE_URL=
PRICEHUBBLE_API_KEY=
PRICEHUBBLE_TIMEOUT=15

# onOffice Lead-Sync (direkte API-Anbindung, kein Zapier)
# API-Benutzer in onOffice enterprise anlegen: Extras -> Einstellungen -> Benutzer
ONOFFICE_BASE_URL=https://api.onoffice.de/api/latest/api.php
ONOFFICE_TOKEN=
ONOFFICE_SECRET=
ONOFFICE_TIMEOUT=20
ONOFFICE_DEBUG=true
ONOFFICE_ESTATE_STATUS2_LABEL="in akquise"
ONOFFICE_ESTATE_STATUS2_CACHE_TTL=86400

# Calendly (zentraler Link für alle Landingpages)
CALENDLY_URL=https://calendly.com/c-glasmacher-2comehome/30min

# CG wird anhand des Benutzerkuerzels aufgeloest; numerische ID optional als Override.
ONOFFICE_ESTATE_USER_INITIALS=CG
ONOFFICE_ESTATE_USER_ID=
